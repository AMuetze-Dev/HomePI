# ---------------------------------------------------------------------------
# cp .env.example .env  und ausfuellen.  .env gehoert NICHT ins Git.
#
# WICHTIG: alle Werte in EINFACHEN Anfuehrungszeichen lassen.
# Die Datei wird sowohl von Docker Compose gelesen als auch von den Skripten
# ge-"source"d. Ohne Quotes zerlegt bash Werte mit ";" und expandiert "$" -
# Passwoerter und der bcrypt-Hash fuer Basic Auth gehen dabei kaputt.
# ---------------------------------------------------------------------------

TZ='Europe/Berlin'
PUID='1000'
PGID='1000'

# --- Basispfad fuer alle Bind-Mounts (legt 10-os-bootstrap.sh an) -----------
DATA_ROOT='/srv/homelab'

# --- Domain / TLS -----------------------------------------------------------
# Eigene Domain, DNS bei Cloudflare.
# Wildcard-A-Record:  *.home.example.com  ->  PI_IP
DOMAIN='home.example.com'
ACME_EMAIL='du@example.com'
# Cloudflare API-Token, Recht: Zone:DNS:Edit fuer genau diese Zone
CF_DNS_API_TOKEN='change-me'

# --- LAN --------------------------------------------------------------------
PI_IP='192.168.1.50'
LAN_CIDR='192.168.1.0/24'

# --- Traefik Dashboard (Basic Auth) -----------------------------------------
# Erzeugen mit:   htpasswd -nbB admin 'deinpasswort'
# Ausgabe UNVERAENDERT hier einsetzen - die Dollarzeichen NICHT verdoppeln,
# die einfachen Anfuehrungszeichen erledigen das.
TRAEFIK_BASIC_AUTH='admin:$2y$05$CHANGEME'

# --- Pi-hole ----------------------------------------------------------------
PIHOLE_PASSWORD='change-me'
# Quad9 (filtert Malware, kein Logging). Alternativen:
#   Cloudflare  1.1.1.1;1.0.0.1
#   dnsforge.de 176.9.93.198;176.9.1.117
PIHOLE_UPSTREAMS='9.9.9.9;149.112.112.112'

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='change-me'
APP_DB_PASSWORD='change-me'
HA_DB_PASSWORD='change-me'

# --- pgAdmin ----------------------------------------------------------------
PGADMIN_EMAIL='du@example.com'
PGADMIN_PASSWORD='change-me'

# --- Zigbee ------------------------------------------------------------------
# Der stabile Pfad des Coordinator-Sticks. Nachsehen mit:
#   ls -la /dev/serial/by-id/
# Niemals /dev/ttyUSB0 eintragen - die Nummer wandert.
ZIGBEE_ADAPTER='/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0'
# Oberflaeche von Zigbee2MQTT zum Anlernen. Nicht 8080 - das gehoert Pi-hole.
Z2M_PORT='8099'

# --- Anwendungs-Images (GHCR) ----------------------------------------------
# ":develop" und nicht ":latest": solange nichts veroeffentlicht wird, laeuft
# auf dem Pi der Entwicklungszweig. Der Tag benennt, woher das Bild kommt -
# ":latest" bleibt einem Release vorbehalten, damit er spaeter nicht
# stillschweigend etwas anderes bedeutet.
GATEWAY_IMAGE='ghcr.io/amuetze-dev/homepi-gateway:develop'
WEB_IMAGE='ghcr.io/amuetze-dev/homepi-web:develop'
