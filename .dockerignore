**/.venv/
**/node_modules/
**/dist/
**/.git/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/coverage/
**/htmlcov/
**/*.pyc
.env
stacks/
docs/
