# syntax=docker/dockerfile:1
# Nur fuer die lokale Entwicklung. Build-Kontext ist die REPO-WURZEL.
FROM node:22-alpine

WORKDIR /app

COPY services/web/package.json services/web/package-lock.json ./
RUN npm ci

COPY services/web .

EXPOSE 5173

# --host, damit der Server im Container von Windows aus erreichbar ist.
# Das Polling fuer Dateiaenderungen steht in vite.config.ts.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
