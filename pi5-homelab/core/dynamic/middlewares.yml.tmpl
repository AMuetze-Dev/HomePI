# Rendered nach middlewares.yml durch scripts/40-render-config.sh (envsubst).
# Traefik ersetzt hier keine Variablen selbst - deshalb das Template.
http:
  middlewares:

    # Nur aus dem eigenen LAN erreichbar. Haengt an allen Admin-Oberflaechen.
    lan-only:
      ipAllowList:
        sourceRange:
          - "${LAN_CIDR}"
          - "127.0.0.1/32"
          - "100.64.0.0/10"   # Tailscale CGNAT-Bereich, falls du es nutzt

    # Global auf dem websecure-Entrypoint aktiv
    secure-headers:
      headers:
        frameDeny: true
        contentTypeNosniff: true
        browserXssFilter: true
        referrerPolicy: "strict-origin-when-cross-origin"
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        customRequestHeaders:
          X-Forwarded-Proto: "https"

    # Fuer oeffentliche/ungeschuetzte Endpunkte: einfache Ratenbegrenzung
    rate-limit:
      rateLimit:
        average: 100
        burst: 50

    # CORS fuer das Frontend gegen die API
    api-cors:
      headers:
        accessControlAllowMethods: ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
        accessControlAllowHeaders: ["Content-Type", "Authorization"]
        accessControlAllowOriginList: ["https://app.${DOMAIN}"]
        accessControlAllowCredentials: true
        accessControlMaxAge: 3600
