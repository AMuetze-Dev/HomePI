# Home Assistant laeuft im Host-Netz und ist deshalb kein Docker-Provider-Ziel.
# Es wird ueber den File-Provider als externer Service eingebunden.
#
# Zwei Voraussetzungen, sonst Zeitueberschreitung bzw. "400: Bad Request":
#   * UFW laesst 172.18.10.0/24 (edge) auf 8123 zu - legt 10-os-bootstrap.sh an.
#   * HA kennt den Proxy. Seit 2026.x NICHT mehr in configuration.yaml, sondern
#     in .storage/http unter data.stable: use_x_forwarded_for und
#     trusted_proxies. Wie: docs/04-runbook.md, "400: Bad Request".

http:
  routers:
    homeassistant:
      rule: "Host(`ha.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: homeassistant
      # kein lan-only: HA soll auch ueber Tailscale erreichbar bleiben

  services:
    homeassistant:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://host.docker.internal:8123"
