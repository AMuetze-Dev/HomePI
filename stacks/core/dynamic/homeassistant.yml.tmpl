# Home Assistant laeuft im Host-Netz und ist deshalb kein Docker-Provider-Ziel.
# Es wird ueber den File-Provider als externer Service eingebunden.
#
# Voraussetzung in HA configuration.yaml (sonst: "400: Bad Request"):
#   http:
#     use_x_forwarded_for: true
#     trusted_proxies:
#       - 172.18.0.0/16      # Subnetz von "edge": docker network inspect edge
#       - 127.0.0.1

http:
  routers:
    homeassistant:
      rule: "Host(`ha.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: homeassistant
      # kein lan-only: HA soll auch ueber Tailscale erreichbar bleiben

  services:
    homeassistant:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://host.docker.internal:8123"
