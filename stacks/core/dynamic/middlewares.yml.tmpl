# Rendered nach middlewares.yml durch scripts/40-render-config.sh (envsubst).
# Traefik ersetzt hier keine Variablen selbst - deshalb das Template.
http:
  middlewares:

    # Nur aus dem eigenen LAN erreichbar. Haengt an allen Admin-Oberflaechen.
    lan-only:
      ipAllowList:
        sourceRange:
          - "${LAN_CIDR}"
          - "127.0.0.1/32"
          - "100.64.0.0/10"   # Tailscale CGNAT-Bereich, falls du es nutzt

    # Global auf dem websecure-Entrypoint aktiv
    secure-headers:
      headers:
        frameDeny: true
        contentTypeNosniff: true
        browserXssFilter: true
        referrerPolicy: "strict-origin-when-cross-origin"
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        customRequestHeaders:
          X-Forwarded-Proto: "https"

    # Fuer oeffentliche/ungeschuetzte Endpunkte: einfache Ratenbegrenzung
    rate-limit:
      rateLimit:
        average: 100
        burst: 50

    # app.<domain>/api/... -> Gateway /...: Das Gateway weiss nichts von
    # dem Praefix, es ist eine Sache der Adresse, unter der die Website es
    # erreicht. Genau so macht es der Vite-Server in der Entwicklung.
    api-praefix:
      stripPrefix:
        prefixes:
          - "/api"

    # Nur fuer die Anmeldung: zehn Versuche je Minute und Adresse. Ein
    # Mensch braucht keine drei; ein Skript, das Namen durchprobiert, kommt
    # damit auf 14 400 am Tag statt auf 8 Millionen. Gezaehlt wird je
    # Quelladresse.
    anmelde-bremse:
      rateLimit:
        average: 10
        period: 1m
        burst: 5

    # Dieselben beiden Bremsen fuer den Eingang "funnel". Dort kommt jede
    # Verbindung vom Docker-Proxy, also von EINER Adresse - ohne ipStrategy
    # teilten sich alle Besucher einen Topf, und zwanzig Spieler vor der
    # Anzeigetafel braeuchten das Limit gemeinsam auf. depth 1 nimmt den
    # letzten Eintrag in X-Forwarded-For: den, den Tailscale gesetzt hat.
    rate-limit-funnel:
      rateLimit:
        average: 100
        burst: 50
        sourceCriterion:
          ipStrategy:
            depth: 1

    anmelde-bremse-funnel:
      rateLimit:
        average: 10
        period: 1m
        burst: 5
        sourceCriterion:
          ipStrategy:
            depth: 1

    # CORS fuer das Frontend gegen die API
    api-cors:
      headers:
        accessControlAllowMethods: ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
        accessControlAllowHeaders: ["Content-Type", "Authorization"]
        accessControlAllowOriginList: ["https://app.${DOMAIN}"]
        accessControlAllowCredentials: true
        accessControlMaxAge: 3600
