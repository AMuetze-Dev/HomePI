"""Der Router gegen eine echte Datenbank.

Als Integration markiert, weil er fast nur aus Datenbankzugriff besteht: gegen
eine nachgebaute Sitzung wuerde man vor allem den Nachbau testen.

    make dev
    HOMEPI_TEST_DATABASE_URL='postgresql+asyncpg://app:app@127.0.0.1:15432/test' \
        uv run pytest -m 'not smoke'
"""

from __future__ import annotations

import pytest
from httpx import AsyncClient

pytestmark = pytest.mark.integration


async def test_leere_liste(client: AsyncClient) -> None:
    assert (await client.get("/{{service}}/")).json() == []


async def test_anlegen_und_lesen(client: AsyncClient) -> None:
    angelegt = await client.post("/{{service}}/", json={"name": "Erster"})

    assert angelegt.status_code == 201
    assert angelegt.json()["name"] == "Erster"
    assert [e["name"] for e in (await client.get("/{{service}}/")).json()] == ["Erster"]


async def test_doppelter_name_wird_abgelehnt(client: AsyncClient) -> None:
    await client.post("/{{service}}/", json={"name": "Erster"})

    antwort = await client.post("/{{service}}/", json={"name": "Erster"})

    assert antwort.status_code == 409
    assert "problem+json" in antwort.headers["content-type"]


async def test_ungueltige_eingabe_nennt_das_feld(client: AsyncClient) -> None:
    antwort = await client.post("/{{service}}/", json={"name": "   "})

    assert antwort.status_code == 422
    assert any("name" in f["feld"] for f in antwort.json()["fehler"])


async def test_unbekannte_kennung_ergibt_404(client: AsyncClient) -> None:
    antwort = await client.get("/{{service}}/00000000-0000-0000-0000-000000000000")

    assert antwort.status_code == 404


async def test_entfernen(client: AsyncClient) -> None:
    angelegt = (await client.post("/{{service}}/", json={"name": "Weg"})).json()

    assert (await client.delete(f"/{{service}}/{angelegt['id']}")).status_code == 204
    assert (await client.get(f"/{{service}}/{angelegt['id']}")).status_code == 404
