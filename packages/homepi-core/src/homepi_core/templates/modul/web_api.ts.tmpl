import { schnittstelle } from "../../api/schnittstelle";

/**
 * Zugriff auf das eigene Backend.
 *
 * Sitzungscookie, JSON und Fehlermeldungen aus problem+json erledigt
 * `schnittstelle` - für jedes Artefakt gleich. Hier stehen nur Pfade und
 * Typen. Eine eigene fetch-Hülle zu schreiben ist die falsche Datei.
 */
const { anfrage, sende } = schnittstelle("/{{service}}");

/** TODO: an die Schemas des Backends anpassen. */
export interface Eintrag {
  id: string;
  name: string;
}

export interface NeuerEintrag {
  name: string;
}

export function ladeEintraege(signal?: AbortSignal): Promise<Eintrag[]> {
  return anfrage<Eintrag[]>("/", {}, signal);
}

export function legeEintragAn(daten: NeuerEintrag): Promise<Eintrag> {
  return sende<Eintrag>("POST", "/", daten);
}

export function entferneEintrag(id: string): Promise<void> {
  return sende<void>("DELETE", `/${encodeURIComponent(id)}`);
}
