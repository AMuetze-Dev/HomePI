# syntax=docker/dockerfile:1
# WICHTIG: Der Build-Kontext ist die REPO-WURZEL, nicht dieses Verzeichnis -
# sonst waere packages/homepi-core nicht erreichbar.
#   docker build -f services/{{service}}/Dockerfile .

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Erst das Basispaket, dann die Abhaengigkeiten dieses Service: beide Schichten
# bleiben im Cache, solange sich die Projektdateien nicht aendern.
COPY packages/homepi-core /app/packages/homepi-core
COPY services/{{service}}/pyproject.toml services/{{service}}/uv.lock /app/services/{{service}}/

WORKDIR /app/services/{{service}}
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

COPY services/{{service}}/src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-editable --no-dev

# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN useradd --create-home --uid 10001 appuser

COPY --from=build --chown=appuser:appuser /app/services/{{service}}/.venv /app/.venv

USER appuser
WORKDIR /app
EXPOSE {{port}}

# Ein Worker. Auf einem Vier-Kern-Pi mit mehreren Services kostet jeder
# weitere rund 120 MB, ohne bei I/O-gebundener Last etwas zu bringen.
# Ueber WEB_CONCURRENCY in der Compose-Datei erhoehbar.
CMD ["sh", "-c", "exec uvicorn homepi_{{modul}}.main:app --host 0.0.0.0 --port {{port}} --workers ${WEB_CONCURRENCY:-1} --proxy-headers --forwarded-allow-ips '*'"]
