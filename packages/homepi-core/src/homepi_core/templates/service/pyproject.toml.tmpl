[project]
name = "homepi-{{service}}"
version = "0.1.0"
description = "HomePI-Microservice: {{service}}"
requires-python = ">=3.12"
dependencies = [
    "homepi-core",
]

[tool.homepi]
service = "{{service}}"
stack = "apps"

[tool.uv.sources]
# Im Monorepo lokal verlinkt, damit Aenderungen an homepi-core sofort wirken.
# Ausserhalb dieses Repos stattdessen:
#   homepi-core = { git = "https://github.com/{{repo}}.git", subdirectory = "packages/homepi-core", tag = "v0.2.0" }
homepi-core = { path = "../../packages/homepi-core", editable = true }

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/homepi_{{modul}}"]

[dependency-groups]
dev = [
    "pytest>=8.3",
    "pytest-asyncio>=0.25",
    "pytest-cov>=6.0",
    "pytest-watcher>=0.4",
    "httpx>=0.28",
    "ruff>=0.9",
    "mypy>=1.14",
]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]
asyncio_mode = "auto"
addopts = "-q --strict-markers --strict-config -m 'not integration'"
markers = ["integration: braucht eine echte Postgres-Instanz"]

[tool.coverage.run]
source = ["homepi_{{modul}}"]
branch = true

[tool.ruff]
line-length = 100
src = ["src", "tests"]
target-version = "py312"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "UP", "B", "SIM", "RUF"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["E501"]

[tool.mypy]
python_version = "3.12"
strict = true
mypy_path = "src"
packages = ["homepi_{{modul}}"]

[[tool.mypy.overrides]]
module = "tests.*"
disallow_untyped_defs = false
