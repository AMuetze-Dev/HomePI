# --- Secrets: niemals einchecken ---
.env
*.pem
*.key
acme.json

# --- aus *.yml.tmpl gerendert, enthaelt die Domain ---
stacks/core/dynamic/*.yml
!stacks/core/dynamic/*.yml.tmpl

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
junit.xml
htmlcov/

# --- Node ---
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/

# --- Werkzeuge / Editor ---
.idea/
.vscode/*
!.vscode/extensions.json
*.local
*.log
.DS_Store

# Playwright: Berichte und Spuren eines fehlgeschlagenen Laufs
services/web/test-results/
services/web/playwright-report/
services/web/blob-report/

# Die Regeldateien eines oertlichen Prueflaufs (make pruefdienst-zusehen).
# Sie gehoeren dem Rechner, nicht dem Projekt -- im Container liegen sie
# auf einem Band.
.dev-regeln/
